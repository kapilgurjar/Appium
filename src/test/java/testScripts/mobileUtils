	public void clickWithRetry(By locator, long timeOut) {
		WebElement ele = getElement(locator);
		try {

			WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(30));
			wait.until(ExpectedConditions.visibilityOf(ele));
			wait.until(ExpectedConditions.elementToBeClickable(ele));
			ele.click();
		} catch (ElementClickInterceptedException exception) {
			// FrameworkLogger.info("Warning :: element was not clicked " +
			// exception.getMessage());
			for (long i = 0; i < timeOut; i++) {
				try {
					sleep(1);
					ele.click();
					break;
				} catch (ElementClickInterceptedException exception1) {
					// FrameworkLogger.info("Warning :: " + exception1.getMessage() + " Try " + i);
				}
			}
		}
	}

	public WebElement retryingElement(By locator, int timeOut) {

		WebElement element = null;

		int attempts = 0;

		while (attempts < timeOut) {

			try {
				element = getElement(locator);
				// FrameworkLogger.info("element is found in attempt: " + attempts);
				break;
			} catch (Exception e) {
				// FrameworkLogger.info("element is not found in attempt : " + attempts + " : "
				// + " for " + locator);

				try {
					Thread.sleep(500);
				} catch (InterruptedException e1) {
					e1.printStackTrace();
				}
			}
			attempts++;

		}

		if (element == null) {
			try {
				throw new Exception("ELEMENTNOTFOUNDEXCEPTION");
			} catch (Exception e) {
				// FrameworkLogger.info("element is not found com.livebarn.exception ...tried
				// for : " + timeOut + " secs"
				// + " with the interval of : " + 500 + " ms");

			}

		}

		return element;

	}


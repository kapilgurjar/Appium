	public String GetColour(By locator) throws IOException {

		waitForElementFound(locator, 30);
		WebElement ele = getElement(locator);

		File screenshot = ele.getScreenshotAs(OutputType.FILE);
		BufferedImage img = ImageIO.read(screenshot);

		// Analyze the screenshot to get the background color (get color of center
		// pixel)
		int centerX = img.getWidth() / 2;
		int centerY = img.getHeight() / 2;
		int rgb = img.getRGB(centerX, centerY);
		// Color color = new Color(rgb);
		// FrameworkLogger.info("Background color: " + color);
		// Extract RGB values
		int red = (rgb >> 16) & 0xFF;
		int green = (rgb >> 8) & 0xFF;
		int blue = rgb & 0xFF;

		// Convert RGB to hex
		String hexColor = String.format("#%02X%02X%02X", red, green, blue);

		// FrameworkLogger.info("Background color code: " + hexColor);
		return hexColor;
	}

	public List<String> getAllColour(By locator) throws IOException {
		waitForElementFound(locator, 30);
		List<String> eleColour = new ArrayList<>();
		List<WebElement> eles = getElements(locator);
		for (WebElement ele : eles) {
			File screenshot = ele.getScreenshotAs(OutputType.FILE);
			BufferedImage img = ImageIO.read(screenshot);

			// Analyze the screenshot to get the background color (get color of center
			// pixel)
			int centerX = img.getWidth() / 2;
			int centerY = img.getHeight() / 2;
			int rgb = img.getRGB(centerX, centerY);
			// Color color = new Color(rgb);
			// FrameworkLogger.info("Background color: " + color);
			// Extract RGB values
			int red = (rgb >> 16) & 0xFF;
			int green = (rgb >> 8) & 0xFF;
			int blue = rgb & 0xFF;

			// Convert RGB to hex
			String hexColor = String.format("#%02X%02X%02X", red, green, blue);

			// FrameworkLogger.info("Background color code: " + hexColor);
			eleColour.add(hexColor);

		}
		return eleColour;
	}


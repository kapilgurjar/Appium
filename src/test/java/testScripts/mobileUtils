	public void pickerWheel1(By locators, String text) {

		boolean flag = false;
		while (!flag) {
			WebElement redPickerWheel = getElement(locators);
			Map<String, Object> params = new HashMap<>();
			params.put("order", "next");
			params.put("offset", 0.15);
			params.put("element", ((RemoteWebElement) redPickerWheel).getId());
			driver.executeScript("mobile: selectPickerWheelValue", params);
			if (redPickerWheel.getText().equals(text)) {
				flag = true;
			}
		}
	}

	public void pickerWheel(By locators, String text) {
		WebElement redPickerWheel = getElement(locators);

		if (redPickerWheel.getText().equals(text)) {
			redPickerWheel.click();
			ElementUtil.sleep(2000);

			return;
		}

		boolean flag = false;
		while (!flag) {
			Map<String, Object> params = new HashMap<>();
			params.put("order", "next");
			params.put("offset", 0.15);
			params.put("element", ((RemoteWebElement) redPickerWheel).getId());
			driver.executeScript("mobile: selectPickerWheelValue", params);

			// Re-fetch element to check updated text
			redPickerWheel = getElement(locators);
			if (redPickerWheel.getText().equals(text)) {
				flag = true;
			}
		}
	}

	private Point getCenterOfElement(Point location, Dimension size) {
		return new Point(location.getX() + size.getWidth() / 2, location.getY() + size.getHeight() / 2);
	}

	public void Zoom(By locator) {

		Point centerOfElement = getCenterOfElement(getElement(locator).getLocation(), getElement(locator).getSize());
		PointerInput finger1 = new PointerInput(PointerInput.Kind.TOUCH, "finger1");
		PointerInput finger2 = new PointerInput(PointerInput.Kind.TOUCH, "finger2");
		Sequence sequence = new Sequence(finger1, 1)
				.addAction(finger1.createPointerMove(Duration.ZERO, PointerInput.Origin.viewport(), centerOfElement))
				.addAction(finger1.createPointerDown(PointerInput.MouseButton.LEFT.asArg()))
				.addAction(new Pause(finger1, Duration.ofMillis(200)))
				.addAction(finger1.createPointerMove(Duration.ofMillis(200), PointerInput.Origin.viewport(),
						centerOfElement.getX() + 100, centerOfElement.getY() - 100))
				.addAction(finger1.createPointerUp(PointerInput.MouseButton.LEFT.asArg()));

		Sequence sequence2 = new Sequence(finger2, 1)
				.addAction(finger2.createPointerMove(Duration.ZERO, PointerInput.Origin.viewport(), centerOfElement))
				.addAction(finger2.createPointerDown(PointerInput.MouseButton.LEFT.asArg()))
				.addAction(new Pause(finger2, Duration.ofMillis(200)))
				.addAction(finger2.createPointerMove(Duration.ofMillis(200), PointerInput.Origin.viewport(),
						centerOfElement.getX() - 300, centerOfElement.getY() + 300))
				.addAction(finger2.createPointerUp(PointerInput.MouseButton.LEFT.asArg()));

		DriverFactoryMobile.getDriver().perform(Arrays.asList(sequence, sequence2));

	}

	public void zoomIn() {
		try {
			// Get screen size
			int screenWidth = DriverFactoryMobile.getDriver().manage().window().getSize().getWidth();
			int screenHeight = DriverFactoryMobile.getDriver().manage().window().getSize().getHeight();

			// Log screen size
			System.out.println("Screen Width: " + screenWidth + ", Screen Height: " + screenHeight);

			int startX1 = screenWidth / 2;
			int startY1 = screenHeight / 2;

			int startX2 = screenWidth / 2;
			int startY2 = screenHeight / 2;

			int endX1 = startX1 - (screenWidth / 6); // Move left
			int endY1 = startY1 - (screenHeight / 6); // Move up

			int endX2 = startX2 + (screenWidth / 6); // Move right
			int endY2 = startY2 + (screenHeight / 6); // Move down

			// Log coordinates
			System.out
					.println("Finger 1: Start (" + startX1 + ", " + startY1 + ") → End (" + endX1 + ", " + endY1 + ")");
			System.out
					.println("Finger 2: Start (" + startX2 + ", " + startY2 + ") → End (" + endX2 + ", " + endY2 + ")");

			PointerInput finger1 = new PointerInput(PointerInput.Kind.TOUCH, "finger1");
			PointerInput finger2 = new PointerInput(PointerInput.Kind.TOUCH, "finger2");

			Sequence sequence1 = new Sequence(finger1, 1)
					.addAction(
							finger1.createPointerMove(Duration.ZERO, PointerInput.Origin.viewport(), startX1, startY1))
					.addAction(finger1.createPointerDown(PointerInput.MouseButton.LEFT.asArg()))
					.addAction(new Pause(finger1, Duration.ofMillis(300))) // Pause for better recognition
					.addAction(finger1.createPointerMove(Duration.ofMillis(500), PointerInput.Origin.viewport(), endX1,
							endY1))
					.addAction(finger1.createPointerUp(PointerInput.MouseButton.LEFT.asArg()));

			Sequence sequence2 = new Sequence(finger2, 1)
					.addAction(
							finger2.createPointerMove(Duration.ZERO, PointerInput.Origin.viewport(), startX2, startY2))
					.addAction(finger2.createPointerDown(PointerInput.MouseButton.LEFT.asArg()))
					.addAction(new Pause(finger2, Duration.ofMillis(300))) // Pause for better recognition
					.addAction(finger2.createPointerMove(Duration.ofMillis(500), PointerInput.Origin.viewport(), endX2,
							endY2))
					.addAction(finger2.createPointerUp(PointerInput.MouseButton.LEFT.asArg()));

			// Perform the gesture
			DriverFactoryMobile.getDriver().perform(Arrays.asList(sequence1, sequence2));

			System.out.println("Zoom-In gesture performed successfully.");
		} catch (Exception e) {
			System.err.println("Zoom-In failed: " + e.getMessage());
		}
	}

	public void zoomOut() {
		try {
			// Get screen size
			int screenWidth = DriverFactoryMobile.getDriver().manage().window().getSize().getWidth();
			int screenHeight = DriverFactoryMobile.getDriver().manage().window().getSize().getHeight();

			// Log screen size
			System.out.println("Screen Width: " + screenWidth + ", Screen Height: " + screenHeight);

			// Define initial touch positions (far apart)
			int startX1 = screenWidth / 2 - (screenWidth / 6); // Left
			int startY1 = screenHeight / 2 - (screenHeight / 6); // Up

			int startX2 = screenWidth / 2 + (screenWidth / 6); // Right
			int startY2 = screenHeight / 2 + (screenHeight / 6); // Down

			// Define touch end positions (closer to center)
			int endX1 = screenWidth / 2;
			int endY1 = screenHeight / 2;

			int endX2 = screenWidth / 2;
			int endY2 = screenHeight / 2;


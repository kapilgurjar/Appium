	public List<String> BrowseLiveBarnVenueList() {
		eleUtil.waitForElementFound(getLocator("favVenuesList"), 240);
		List<String> favvenues = new ArrayList<>();
		ElementUtil.sleep(2000);
		List<WebElement> eles = eleUtil.getElements(getLocator("favVenuesList"));
		for (WebElement ele : eles) {
			String name = ele.getDomAttribute("value");
			// System.out.println("get all the venues name " + name);
			favvenues.add(name);
		}
		return favvenues;
	}


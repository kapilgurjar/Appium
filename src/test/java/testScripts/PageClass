	@Step("Login to app and get the venu page title")
	public String loginToIOSApp(String email, String pass) {

		eleUtil.AcceptAlertIfPresent();
		eleUtil.doSendKeys(getLocator("email_TextBox"), email);
		eleUtil.doSendKeys(getLocator("pass_TextBox"), pass);
		eleUtil.clickWithRetry(getLocator("loginButton"), timeOut);
		if (eleUtil.isDisplayed(getLocator("updatePass"))) {
			eleUtil.doClick(getLocator("updatePass"));
		}
//	eleUtil.doClick(closeButtonMntText);
//			
//		}
		eleUtil.waitForElementFound(getLocator("favVenue"), timeOut);
		return eleUtil.doGetAttribute(getLocator("favVenue"), "name", timeOut);
	}

